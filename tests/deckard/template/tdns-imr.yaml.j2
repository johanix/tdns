# tdns-imr config, rendered by Deckard for one scenario run.
# Source: tests/deckard/template/tdns-imr.yaml.j2 in the tdns repository.
listeners:
   addresses:  [ {% if ':' in SELF_ADDR %}'[{{SELF_ADDR}}]:53'{% else %}'{{SELF_ADDR}}:53'{% endif %} ]
   transports: [ do53 ]

imrengine:
   # Deckard's template/hints_zone.j2: ". NS <ROOT_NAME>" plus its address.
   root-hints: "{{WORKING_DIR}}/hints.zone"
{% if TRUST_ANCHORS %}
   # One DS or DNSKEY per line, from the scenario's trust-anchor entries.
   trust-anchor-file: "{{WORKING_DIR}}/ta.keys"
{% endif %}
   # Keeps the experimental transport-signal option off outgoing queries.
   options: [ "use-transport-signals:false" ]
   # The scenarios predate RFC 9276, and RFC 5155's example zone uses 12 NSEC3
   # iterations: 150 instead of the default 10, so their proofs are judged.
   tuning:
      nsec3-max-iterations: 150
   # The scenario's do-ip4 and do-ip6.
   outbound-address-families: [ {% if DO_IP4 == "true" %}ipv4{% endif %}{% if DO_IP4 == "true" and DO_IP6 == "true" %}, {% endif %}{% if DO_IP6 == "true" %}ipv6{% endif %} ]
   # Designed in docs/2026-09-28-imr-deckard-test-clock-and-switches.md.
   # priming, faketime and root-refresh are implemented. faketime reads the
   # clock Deckard writes to $FAKETIME_TIMESTAMP_FILE, and implies
   # root-refresh: false. tdns-imr logs the others as unknown keys at start-up
   # and ignores them.
   testing:
      faketime:        true
      anchor-prefetch: false
      root-refresh:    false
      priming:         false
      ns-pick:         ordered
      forward-probe:   false

apiserver:
   apikey: "deckard"

log:
   file:  "{{WORKING_DIR}}/tdns-imr.log"
   level: debug
   # log.level alone raises no subsystem logger; the resolver logs as
   # "engine" (imrengine.go) and "dns" (dnslookup.go).
   subsystems:
      engine: debug
      dns:    debug
